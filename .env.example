PORT=4000
NODE_ENV=development
VITE_API_URL=http://localhost:4000/api/v1
# PostgreSQL is required in production. Leave empty only for local fallback development.
DATABASE_URL=postgresql://societyhub:change-me@localhost:5432/societyhub?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
# Select a live adapter only after implementing it and supplying its credentials.
PAYMENT_PROVIDER=development
EMAIL_PROVIDER=development
SMS_PROVIDER=development
# PAYMENT_PROVIDER_SECRET=
# EMAIL_PROVIDER_SECRET=
# SMS_PROVIDER_SECRET=
LOG_LEVEL=info