PORT=4000
NODE_ENV=development
VITE_API_URL=http://localhost:4000/api/v1
APP_URL=http://localhost:8080
# PostgreSQL is required in production. Leave empty only for local fallback development.
DATABASE_URL=postgresql://societyhub:replace-with-your-postgres-password@localhost:5432/societyhub?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# Use same-origin when the API serves the frontend from the same host.
# Used by Docker Compose. Keep URL-reserved characters out of this password.
POSTGRES_PASSWORD=replace-with-a-local-compose-password
# Stripe checkout is implemented; add both Stripe secrets before selecting stripe.
PAYMENT_PROVIDER=development
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Live email and SMS adapters are not implemented; production rejects them.
EMAIL_PROVIDER=development
SMS_PROVIDER=development
LOG_LEVEL=info
